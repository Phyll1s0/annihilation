msgstr "关卡文件过大。"

msgid "The file is not valid JSON."
msgstr "文件不是有效的 JSON。"

msgid "Level imported. Verify its minimum to enable Hard."
msgstr "关卡已导入，验证最少步数后可启用困难模式。"

msgid "Could not open the level file."
msgstr "关卡文件打开失败。"

msgid "Level exported."
msgstr "关卡已导出。"

msgid "This portal already has two ends."
msgstr "这组传送阵已有两个端点。"

msgid "Place at least one black and one white particle."
msgstr "至少放置一颗白子和一颗黑子。"

msgid "Black and white counts must match."
msgstr "黑子和白子的数量必须相等。"

msgid "Every portal group needs exactly two ends."
msgstr "每组传送阵需要两个端点。"

msgid "Choose a NULL level JSON file."
msgstr "请选择 NULL 关卡 JSON 文件。"

msgid "Unsupported level file version."
msgstr "不支持这个关卡文件版本。"

msgid "Maps can be up to 12 by 12 tiles."
msgstr "地图最多为 12 × 12 格。"

msgid "All rows must have the same width."
msgstr "地图各行的宽度必须相同。"

msgid "The map contains an unknown tile."
msgstr "地图含有未知格子。"

msgid "Invalid particle positions."
msgstr "棋子位置无效。"

msgid "A particle overlaps another particle or a missing tile."
msgstr "棋子与另一颗棋子或空洞重叠。"

msgid "Draft"
msgstr "草稿"

msgid "Could not verify the minimum."
msgstr "未能验证最少步数。"

msgid "Undo · Ctrl/Cmd Z"
msgstr "撤销 · Ctrl/Cmd Z"

msgid "Create"
msgstr "创作"

msgid "Erase piece"
msgstr "擦除棋子"

msgid "Place a floor; keep the particle."
msgstr "放置普通格子，保留棋子。"

msgid "Remove the tile and its particle. Right click also does this."
msgstr "删除格子及其棋子，右键也有同样效果。"

msgid "Place a white particle."
msgstr "放置白色棋子。"

msgid "Place a black particle."
msgstr "放置黑色棋子。"

msgid "Remove only the particle; keep the floor or portal."
msgstr "只擦除棋子，保留普通格子或传送阵。"

msgid "Place one end of the selected portal group."
msgstr "放置所选传送阵组的一个端点。"

msgid "Leaderboard"
msgstr "排行榜"

msgid "Local leaderboard"
msgstr "本地排行榜"

msgid "Player name"
msgstr "玩家名称"

msgid "No records yet"
msgstr "暂无纪录"

msgid "Best known: %d move"
msgid_plural "Best known: %d moves"
msgstr[0] "当前纪录：%d 步"

msgid "Drag to paint. Right click removes tiles."
msgstr "拖动绘制；右键删除整个格子。"

msgid "Best run per name."
msgstr "每个名称保留最佳成绩。"

msgid "Best run per name. Export JSON to share this map and its records; import a friend's JSON to merge their scores."
msgstr "每个名称保留最佳成绩。导出 JSON 分享关卡和纪录；导入朋友的 JSON 合并成绩。"

msgid "Could not save records."
msgstr "纪录保存失败。"

msgid "Level imported. Invalid scores were skipped."
msgstr "关卡已导入，无效成绩已跳过。"

msgid "Level and records imported."
msgstr "关卡和纪录已导入。"

msgid "New record"
msgstr "新纪录"

msgid "Moves: %d · Best known: %d"
msgstr "本次：%d 步 · 当前纪录：%d 步"

msgid "Choose a level · Enter"
msgstr "选择关卡 · 回车"

msgid "Play"
msgstr "游玩"

msgid "Edit"
msgstr "编辑"

msgid "Back to my levels"
msgstr "返回我的关卡"

msgid "Finish this map in the editor before playing."
msgstr "先在编辑器中补全关卡，再开始游玩。"

msgid "No saved levels yet. Create a level and choose Save to add it here."
msgstr "暂无已保存关卡。创作关卡并点击保存，即可添加到这里。"

msgid "Level saved to My levels."
msgstr "已保存到我的关卡。"

msgid "Audio"
msgstr "音频"

msgid "Music"
msgstr "背景音乐"

msgid "Volume"
msgstr "音量"
